{
  "name": "@glowingbear/weechat-format",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free TypeScript decoder for the WeeChat inline chat color/attribute protocol (WeeChat 4.10.1 semantics).",
  "license": "GPL-3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "bench": "npm run build && node bench/parse.bench.mjs",
    "lint": "eslint src test bench oracle",
    "smoke:dist": "npm run build && node test/smoke-dist.mjs",
    "oracle:build": "cc -O2 -std=c99 -Wall -Wextra -o oracle/build/weechat-color-scan oracle/weechat_color_scan.c",
    "oracle": "npm run oracle:build && node oracle/generate.mjs"
  }
}
