packages/weechat-format/oracle/build/

# Generated WeeChat consumption-oracle evidence: the vendored upstream scanner,
# the corpus and the scanner's verdicts. `npm run oracle` (needs cc) rebuilds the
# corpus and verdicts from the scanner, but the scanner itself has to be re-vendored
# from WeeChat 4.10.1 by hand. The tracked record is oracle/divergences.json.
packages/weechat-format/oracle/weechat_color_scan.c
packages/weechat-format/oracle/corpus.txt
packages/weechat-format/oracle/weechat-oracle.txt
artifacts/

# `npm run build` runs static/generate-icons.mjs, which rewrites this file even
# though nothing reads it: b3fce836 untracked it and moved manifest generation into
# the PWA plugin (app.html links to the generated manifest.webmanifest). It only
# reappears when an icon actually regenerates, which is why it sat unnoticed until a
# `git add -A` swept a build artifact into a refactor commit.
static/webapp.manifest.json
