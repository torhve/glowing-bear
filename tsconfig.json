{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "es2022",
    "strict": true,
    "disableSizeLimit": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vite/client",
      "node",
      "$app/types"
    ]
  },
  "include": [
    "src-svelte/src/**/*.d.ts",
    "src-svelte/src/**/*.js",
    "src-svelte/src/**/*.ts",
    "src-svelte/src/**/*.svelte",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src-svelte/.svelte-kit",
    "src-svelte/src/service-worker"
  ]
}
