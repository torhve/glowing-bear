{
  // Every unit test file is typechecked. There is no excluded set: the backlog that used to
  // live here was fixtures hand-built with fields the production types now require
  // (`BufferSnapshot` without `modes`, `LineSnapshot` without `y`), and each was rebuilt from
  // a builder rather than cast away. A new test therefore cannot arrive type-unchecked.
  //
  // `perf/` and `prof/` are excluded because `npm test` never runs them; `npm run test:perf`
  // is its own gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    // The old-protocol fixture is JavaScript, and the parity tests import it on purpose:
    // its own type errors belong to that frozen fixture, not to the tests asking for it.
    "checkJs": false
  },
  "include": ["src-svelte/test/unit/**/*.ts"],
  "exclude": [
    "src-svelte/test/unit/perf",
    "src-svelte/test/unit/prof"
  ]
}
