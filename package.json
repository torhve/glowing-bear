{
  "name": "glowing-bear",
  "private": true,
  "version": "0.23.1",
  "description": "Glowing Bear — A web client for WeeChat",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node static/generate-icons.mjs",
    "build": "vite build",
    "build:docker": "vite build",
    "generate-icons": "node static/generate-icons.mjs",
    "generate-icns": "node static/generate-icns.mjs",
    "preview": "vite preview",
    "check": "npm run check:app && npm run check:sw",
    "check:app": "svelte-check --tsconfig ./tsconfig.app.json",
    "check:sw": "tsc --noEmit -p src-svelte/src/service-worker/tsconfig.json",
    "lint": "eslint src-svelte/src src-svelte/test src-svelte/e2e",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=src-svelte/e2e/playwright.config.ts",
    "test:e2e:watch": "playwright test --ui --config=src-svelte/e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --debug --config=src-svelte/e2e/playwright.config.ts",
    "irc:server": "npx tsx test/irc-server/index.ts",
    "irc:start": "bash test/fixtures/gbtest/start.sh",
    "irc:stop": "bash test/fixtures/gbtest/stop.sh",
    "tauri": "npx tauri",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@lucide/svelte": "^1.51.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "fflate": "^0.8.3",
    "zlibjs": "^0.3.1"
  },
  "imports": {
    "#lib/*": "./src-svelte/src/lib/*",
    "#components": "./src-svelte/src/components/index.ts",
    "#components/*": "./src-svelte/src/components/*"
  }
}
